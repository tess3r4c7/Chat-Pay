generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                Int                       @id @default(autoincrement())
  email             String                    @unique
  password          String
  name              String
  number            BigInt                    @unique
  publicKey         String?
  OnRampTransaction OnRampTransaction[]
  Balance           Balance[]
  sentTransfers     p2pTransfer[]             @relation("SentTransfers")
  receivedTransfers p2pTransfer[]             @relation("ReceivedTransfers")
  conversations     ConversationParticipant[]
  sentMessages      Message[]
}

model Balance {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  amount Int  @default(0)
  locked Int  @default(0)
  user   User @relation(fields: [userId], references: [id])
}

model OnRampTransaction {
  id        Int          @id @default(autoincrement())
  status    OnRampStatus
  token     String       @unique
  amount    Int
  startedAt DateTime     @default(now())
  userId    Int
  user      User         @relation(fields: [userId], references: [id])
}

model p2pTransfer {
  id         Int      @id @default(autoincrement())
  amount     Int
  timestamp  DateTime @default(now())
  senderId   Int
  receiverId Int
  sender     User     @relation(name: "SentTransfers", fields: [senderId], references: [id])
  receiver   User     @relation(name: "ReceivedTransfers", fields: [receiverId], references: [id])
}

model Conversation {
  id           Int                       @id @default(autoincrement())
  createdAt    DateTime                  @default(now())
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             Int          @id @default(autoincrement())
  conversationId Int
  userId         Int
  publickey      String       @default("")
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  senderId       Int
  cipherText     String
  nonce          String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         User         @relation(fields: [senderId], references: [id])
}

enum OnRampStatus {
  PENDING
  FAILED
  COMPLETED
}

